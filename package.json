{
  "name": "@onedice/core",
  "version": "1.0.2",
  "description": "node implement of onedice",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/v1 test/issues",
    "test:browser": "npm run build && vitest run test/browser",
    "test:watch": "vitest test/v1 test/issues",
    "playground": "vite --host 127.0.0.1 examples/playground",
    "playground:build": "vite build examples/playground"
  },
  "author": "anillc",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@types/js-yaml": "^4.0.5",
    "@types/lodash.groupby": "^4.6.7",
    "@types/lodash.uniqwith": "^4.5.7",
    "@types/node": "^18.7.6",
    "js-yaml": "^4.1.0",
    "lodash.groupby": "^4.6.0",
    "lodash.uniqwith": "^4.5.0",
    "ts-node": "^10.9.1",
    "tsup": "^8.5.1",
    "typescript": "^4.7.4",
    "vite": "^5.4.21",
    "vitest": "^0.34.6"
  }
}
